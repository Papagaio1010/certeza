# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase.
# As variáveis VITE_* são lidas no navegador; as demais são usadas apenas no servidor (SSR).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-ou-anon
VITE_SUPABASE_PROJECT_ID=seu-project-id

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-ou-anon
SUPABASE_PROJECT_ID=seu-project-id

# Necessária apenas para operações administrativas no servidor (nunca exponha no navegador).
# SUPABASE_SERVICE_ROLE_KEY=
